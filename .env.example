MAX_FILE_MB=15
MAX_FILES_PER_BATCH=1000
MAX_REQUEST_MB=100
MIN_IMAGE_SIDE=300
MAX_IMAGE_PIXELS=144000000   # 12000x12000, PIL decompression-bomb guard
WORKER_COUNT=            # blank = cpu_count - 1
ENABLE_WORKER_POOL=1     # 0 disables background processing (used by fast unit tests)
IMAGE_TIMEOUT_S=60
WORKING_MAX_SIDE=2000
THUMBNAIL_MAX_SIDE=160
OCR_PROVIDER=rapidocr    # reserved for a future pluggable OCR backend; only rapidocr is wired up today
SCENE_PROVIDER=heuristic # none | heuristic | ollama | clip
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
DATA_DIR=data
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
